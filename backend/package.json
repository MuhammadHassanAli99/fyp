{
  "name": "marketplace-api",
  "version": "1.0.0",
  "private": true,
  "description": "Global 3-in-1 marketplace API — Gold, Property, Vehicles. Modular monolith on Express 5 + MySQL.",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:check": "tsx src/scripts/migrate.ts --check",
    "db:migrate:dry": "tsx src/scripts/migrate.ts --dry",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:production": "tsx src/scripts/seed.ts --production",
    "db:seed:production:dry": "tsx src/scripts/seed.ts --production --dry",
    "db:checksums": "tsx src/scripts/reconcile-checksums.ts",
    "db:checksums:reconcile": "tsx src/scripts/reconcile-checksums.ts --reconcile",
    "db:reset": "tsx src/scripts/migrate.ts --fresh",
    "db:backup": "tsx src/scripts/backup.ts",
    "jobs": "tsx src/jobs/runner.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.1.1",
    "pino": "^10.3.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
