# ===========================================================================
# STAGING environment template
#
# Staging exists to rehearse production, so it runs with NODE_ENV=production —
# which means the same boot guards, the same HSTS and CSP headers, the same
# refusal to start on a placeholder secret. A staging box on
# NODE_ENV=development would skip OTP throttling and return OTP codes in API
# responses, and would therefore test nothing.
#
# Everything is SEPARATE from production:
#   - its own database (never a copy of production data containing real PII)
#   - its own JWT and encryption secrets
#   - its own OAuth clients and redirect URIs
#   - its own storage bucket
#   - its own webhook endpoints
#   - payment providers in TEST mode
#
# Copy to `.env.staging` on the staging host and fill every <placeholder>.
# Never commit the filled version.
# ===========================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=<Your Marketplace> (Staging)

APP_URL=https://api.staging.<your-domain>
WEB_URL=https://staging.<your-domain>

# `debug` here, `info` in production: staging is where you want the detail.
LOG_LEVEL=debug
LOG_PRETTY=false

SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# Database — a distinct database, and ideally a distinct server.
# Do not restore a production dump here unless it has been anonymised: staging
# has weaker access controls and more people can read it.
# ---------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=<marketplace_staging>
DB_PASSWORD=<staging_db_password>
DB_NAME=<marketplace_staging>
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
DB_TIMEZONE=Z
DB_SSL_MODE=disabled

# Required by docker-compose.yml when MySQL runs in the stack.
MYSQL_ROOT_PASSWORD=<staging_mysql_root_password>

# ---------------------------------------------------------------------------
# Cache — exercise the Redis path here, because a single-replica staging box
# on the in-memory driver will not reveal cross-process cache or rate-limit
# bugs that only appear in production.
# ---------------------------------------------------------------------------
REDIS_PASSWORD=<staging_redis_password>
REDIS_URL=redis://:<staging_redis_password>@redis:6379
CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Secrets — generate fresh. A staging secret must never equal a production one:
# a staging-issued token would then be accepted by production.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=<staging_access_secret_32_chars_minimum>
JWT_REFRESH_SECRET=<staging_refresh_secret_must_differ>
JWT_ISSUER=marketplace-api
JWT_AUDIENCE=marketplace-app
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=<staging_32_byte_hex_key>

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://staging.<your-domain>,https://admin.staging.<your-domain>
TRUST_PROXY=true
BODY_LIMIT=2mb

# Production values, so load and abuse behaviour matches.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_PRIVACY_MAX=8
RATE_LIMIT_PASSWORD_MAX=8
RATE_LIMIT_OAUTH_MAX=15
WAF_ENABLED=true

# Staging is where the restore procedure gets rehearsed before it is needed.
RPO_MINUTES=60
RTO_MINUTES=120
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Auth policy — mirror production
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=8
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGINS=8
ACCOUNT_LOCK_MINUTES=30
SESSION_IDLE_HOURS=336
MFA_CHALLENGE_TTL_SECONDS=300

# Passkeys are origin-bound, so staging needs its own RP ID. A passkey enrolled
# on staging will not work on production, which is the intended isolation.
WEBAUTHN_RP_ID=staging.<your-domain>
WEBAUTHN_RP_NAME=<Your Marketplace> (Staging)
WEBAUTHN_ORIGIN=https://staging.<your-domain>

# ---------------------------------------------------------------------------
# OAuth — SEPARATE clients with staging redirect URIs.
# Reusing the production client would require adding staging redirect URIs to
# it, which widens the production attack surface.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_IDS=<staging_web_client_id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<staging_google_client_secret>
APPLE_CLIENT_IDS=<staging.service.id>
FACEBOOK_APP_ID=<staging_facebook_app_id>
FACEBOOK_APP_SECRET=<staging_facebook_app_secret>
MICROSOFT_CLIENT_ID=<staging_microsoft_client_id>
MICROSOFT_CLIENT_SECRET=<staging_microsoft_client_secret>
MICROSOFT_TENANT=common
TURNSTILE_SECRET=<staging_turnstile_secret>
CAPTCHA_TTL_SECONDS=300

LISTING_TTL_DAYS=30
LISTING_MAX_MEDIA=20
GUEST_SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Email — a real transport is required (NODE_ENV=production refuses `log`).
#
# Use a catch-all mailbox or a mail sink so staging cannot email real users.
# A staging job that emails your actual customer list is a genuine hazard.
# ---------------------------------------------------------------------------
EMAIL_DRIVER=smtp
EMAIL_FROM=<Your Marketplace> Staging <no-reply@staging.<your-domain>>
EMAIL_REPLY_TO=staging-support@<your-domain>
SMTP_HOST=<staging_smtp_host>
SMTP_PORT=587
SMTP_REQUIRE_TLS=true
SMTP_USER=<staging_smtp_username>
SMTP_PASSWORD=<staging_smtp_password>
SMTP_TIMEOUT_MS=15000
SMTP_MAX_CONNECTIONS=2

# SMS costs real money on staging too. Keep it on `log` unless you are
# specifically testing SMS delivery.
SMS_DRIVER=log

# ---------------------------------------------------------------------------
# Push — a SEPARATE Firebase project, or at minimum separate apps.
# Sharing the production project means a staging test push can reach a real
# user's device.
# ---------------------------------------------------------------------------
PUSH_DRIVER=fcm
FCM_SERVICE_ACCOUNT_JSON=<staging_service_account_json>
PUSH_TIMEOUT_MS=10000
PUSH_CONCURRENCY=4
PUSH_ANDROID_CHANNEL_ID=marketplace_default

# WhatsApp conversations are billed on staging as well.
WHATSAPP_DRIVER=log
WHATSAPP_TIMEOUT_MS=15000
OTP_WHATSAPP_FALLBACK_TO_SMS=true

NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_JOB_BATCH=20

# ---------------------------------------------------------------------------
# Storage — a separate bucket or prefix. Never the production bucket: a
# staging deletion test would destroy real listing media.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=s3
S3_BUCKET=<staging_bucket>
S3_REGION=<region>
S3_ACCESS_KEY_ID=<staging_access_key_id>
S3_SECRET_ACCESS_KEY=<staging_secret_access_key>
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=https://cdn.staging.<your-domain>
STORAGE_LOCAL_DIR=storage/uploads
FFMPEG_PATH=/usr/bin/ffmpeg

BASE_CURRENCY=USD
DEFAULT_COUNTRY=<US>
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# Point AI at a low-spend key here; staging load can be unpredictable.
AI_PROVIDER=heuristic
# AI_API_KEY=<staging_ai_key>
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
GEO_DRIVER=local
FX_DRIVER=ecb
GOLD_RATE_DRIVER=static
IP_REPUTATION_DRIVER=heuristic
MAP_PROVIDER=openstreetmap

ENABLE_JOBS=true
ENABLE_REALTIME=true
# Useful on staging for exploring the API.
ENABLE_SWAGGER=true

STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TELECOM_DRIVER=log
CALL_RING_TIMEOUT_SECONDS=45
MESSAGE_EDIT_WINDOW_MINUTES=15
CHAT_MEDIA_URL_TTL_SECONDS=3600
MASKED_CALL_TTL_HOURS=24
MASKED_CALLS_PER_DAY=20

# ---------------------------------------------------------------------------
# Payments — TEST MODE ONLY.
#
# A live key on staging will charge real cards. `sk_test_` / sandbox only.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=<sk_test_...>
STRIPE_PUBLISHABLE_KEY=<pk_test_...>
STRIPE_WEBHOOK_SECRET=<staging_whsec_...>
PAYPAL_CLIENT_ID=<paypal_sandbox_client_id>
PAYPAL_CLIENT_SECRET=<paypal_sandbox_secret>
PAYPAL_WEBHOOK_ID=<paypal_sandbox_webhook_id>
PAYPAL_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=<staging_payment_webhook_secret>
SUPPORT_WEBHOOK_SECRET=<staging_support_webhook_secret>

# ---------------------------------------------------------------------------
# docker-compose.yml conveniences
# ---------------------------------------------------------------------------
API_PORT=3000
ENV_FILE=backend/.env.staging
