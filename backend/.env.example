# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=Marketplace
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173
LOG_LEVEL=debug
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Database (MySQL 8.0+)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marketplace
DB_POOL_SIZE=15
DB_TIMEZONE=Z
# TLS to MySQL. `required` verifies the certificate; `required-no-verify`
# encrypts without verifying. Production warns when this is disabled.
DB_SSL_MODE=disabled
# DB_SSL_CA=
DB_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Cache (optional; in-memory is used when unset)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Security — MUST be replaced with 32+ byte random values before production.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_ISSUER=marketplace-api
JWT_AUDIENCE=marketplace-app
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------------
# Localisation defaults
# ---------------------------------------------------------------------------
BASE_CURRENCY=USD
DEFAULT_COUNTRY=US
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ORIGINS=*
TRUST_PROXY=false
BODY_LIMIT=2mb

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_PRIVACY_MAX=8
RATE_LIMIT_PASSWORD_MAX=8
RATE_LIMIT_OAUTH_MAX=15

# Application-layer WAF (CDN/WAF still required in production)
WAF_ENABLED=true

# Disaster recovery targets (minutes). Not a claim of tested restoration.
RPO_MINUTES=15
RTO_MINUTES=60
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Auth policy
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=8
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGINS=8
ACCOUNT_LOCK_MINUTES=30
SESSION_IDLE_HOURS=336
MFA_CHALLENGE_TTL_SECONDS=300
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Marketplace
WEBAUTHN_ORIGIN=http://localhost:3000

# OAuth — client IDs are public; secrets stay on the server. Never put these in Flutter.
# GOOGLE_CLIENT_IDS=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_IDS=com.example.marketplace
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# Cloudflare Turnstile. Without it a weaker internal captcha is used.
# TURNSTILE_SECRET=
CAPTCHA_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Listings
# ---------------------------------------------------------------------------
LISTING_TTL_DAYS=30
LISTING_MAX_MEDIA=20
GUEST_SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Providers. Each value selects a driver in src/providers.
# The defaults are offline-friendly: no external account needed to run locally.
# ---------------------------------------------------------------------------
AI_PROVIDER=heuristic
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
# CDN_PUBLIC_URL=https://cdn.example.com
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
# FFMPEG_PATH=

# ---------------------------------------------------------------------------
# Messaging
#
# `log` writes to stdout and delivers nothing — the right default locally, and
# refused at boot when NODE_ENV=production (email only). OTP codes are also
# printed as a banner in development so sign-in works with no accounts set up.
#
# To exercise real delivery locally, point SMTP at a catcher such as MailHog
# or Mailpit on 1025 rather than a real relay.
# ---------------------------------------------------------------------------
EMAIL_DRIVER=log
EMAIL_FROM=Marketplace <no-reply@localhost>
# EMAIL_REPLY_TO=support@localhost
# EMAIL_DRIVER=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# Leave unset to infer: implicit TLS on 465, STARTTLS otherwise.
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_TIMEOUT_MS=15000
SMTP_MAX_CONNECTIONS=5

# `ses`/`sendgrid`/`http` POST this project's own JSON shape to EMAIL_API_URL.
# They are NOT provider SDKs — pointing them straight at SendGrid or SES will
# fail, because those APIs expect a different body. Use them with a relay you
# control, or use EMAIL_DRIVER=smtp.
# EMAIL_API_URL=
# EMAIL_API_KEY=

SMS_DRIVER=log
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=

# Push uses FCM HTTP v1, which needs a service account — the legacy server-key
# API is decommissioned, so PUSH_API_KEY alone will not work.
PUSH_DRIVER=log
# PUSH_DRIVER=fcm
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# For PUSH_DRIVER=apns/webpush/http: a relay accepting this project's shape.
# PUSH_API_URL=
# PUSH_API_KEY=
PUSH_TIMEOUT_MS=10000
PUSH_CONCURRENCY=8
# PUSH_ANDROID_CHANNEL_ID=marketplace_default
# PUSH_WEB_ICON_URL=

# WhatsApp Business Cloud API. NOT free — conversation pricing applies, and
# business-initiated messages need pre-approved templates.
WHATSAPP_DRIVER=log
# WHATSAPP_DRIVER=cloud
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_OTP_TEMPLATE_NAME=
# WHATSAPP_ALERT_TEMPLATE_NAME=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Meta template locale tags you have approved, e.g. en_US,ar,ur
WHATSAPP_TEMPLATE_LANGUAGES=en_US
WHATSAPP_TIMEOUT_MS=15000
OTP_WHATSAPP_FALLBACK_TO_SMS=true

NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_JOB_BATCH=40

GEO_DRIVER=local
FX_DRIVER=static
GOLD_RATE_DRIVER=static
# Offline IP intel. Swap to a licensed driver in production; never treat VPN as automatic fraud.
IP_REPUTATION_DRIVER=heuristic

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------
MAP_PROVIDER=openstreetmap
# GOOGLE_MAPS_API_KEY=
# MAP_TILE_URL=
# MAP_SATELLITE_TILE_URL=

# ---------------------------------------------------------------------------
# Graceful shutdown
# ---------------------------------------------------------------------------
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# Realtime / calling
# ---------------------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
# A TURN relay is required for peers behind symmetric NAT (~10-20% of calls).
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_SECRET=
TELECOM_DRIVER=log
CALL_RING_TIMEOUT_SECONDS=45
MESSAGE_EDIT_WINDOW_MINUTES=15
CHAT_MEDIA_URL_TTL_SECONDS=3600
MASKED_CALL_TTL_HOURS=24
MASKED_CALLS_PER_DAY=20

# ---------------------------------------------------------------------------
# Toggles
# ---------------------------------------------------------------------------
ENABLE_JOBS=true
ENABLE_REALTIME=true
ENABLE_SWAGGER=true

# Payment providers — never put these in Flutter. Publishable/client IDs are public.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=sandbox
# PAYMENT_WEBHOOK_SECRET=

# Support channel webhooks (email / WhatsApp / telephony). Unsigned in development when unset.
# SUPPORT_WEBHOOK_SECRET=
