# ===========================================================================
# PRODUCTION environment template
#
# Copy to a secret store (not to a file on disk if you can avoid it) and fill
# every <placeholder>. NEVER commit the filled version.
#
#   cp .env.production.example .env    # on the production host only
#
# The backend refuses to boot in production when any of the following is still
# wrong (src/config/env.ts). This is deliberate: each one fails silently at
# runtime otherwise, which is far more expensive to diagnose.
#
#   - a JWT secret containing "change-me", or shorter than 32 characters
#   - the default ENCRYPTION_KEY
#   - CORS_ORIGINS containing *
#   - an empty DB_PASSWORD
#   - APP_URL / WEB_URL on http:// or localhost
#   - WEBAUTHN_RP_ID left as localhost   (silently breaks every passkey)
#   - EMAIL_DRIVER=log                   (silently swallows every OTP)
#   - STORAGE_PUBLIC_URL on localhost    (silently breaks all media)
#   - STORAGE_DRIVER=gcs or azure        (no driver implemented)
#
# Full reference: docs/ENVIRONMENT_VARIABLES.md
# Service setup:  docs/PRODUCTION_CONFIGURATION.md
# ===========================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=<Your Marketplace Name>

# Public origins. Must be https and must not be localhost.
APP_URL=https://api.<your-domain>
WEB_URL=https://<your-domain>

# Newline-delimited JSON to stdout; the log shipper parses it.
LOG_LEVEL=info
LOG_PRETTY=false

# Graceful shutdown. DRAIN must exceed your load balancer's health-check
# interval so it deregisters this instance before the listener closes.
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# Database (MySQL 8.0+)
# ---------------------------------------------------------------------------
DB_HOST=<db-host>
DB_PORT=3306
# A dedicated least-privilege user. NOT root.
DB_USER=<marketplace_app>
DB_PASSWORD=<store_in_secret_manager>
DB_NAME=<marketplace_production>
DB_POOL_SIZE=25
DB_CONNECT_TIMEOUT_MS=10000
DB_TIMEZONE=Z

# `required` verifies the server certificate. Use `required-no-verify` only for
# a managed provider presenting a certificate for an internal hostname.
DB_SSL_MODE=required
# DB_SSL_CA=/etc/ssl/certs/db-ca.pem

# ---------------------------------------------------------------------------
# Cache and shared counters
#
# Without Redis, cache entries and rate-limit counters are per-process. With
# more than one replica that means a client gets N times the intended rate
# limit. Required for any multi-instance deployment.
# ---------------------------------------------------------------------------
REDIS_URL=redis://:<redis_password>@<redis-host>:6379
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Secrets — generate fresh, never reuse across environments
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating JWT_ACCESS_SECRET invalidates access tokens (users recover silently
# on refresh). Rotating JWT_REFRESH_SECRET signs everyone out.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=<store_in_secret_manager>
JWT_REFRESH_SECRET=<store_in_secret_manager_must_differ_from_access>
JWT_ISSUER=marketplace-api
JWT_AUDIENCE=marketplace-app
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts provider secrets and MFA seeds at rest. 32 bytes, hex or base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this makes existing encrypted rows unreadable. Re-encrypt,
# do not just rotate. See docs/SECRETS_MANAGEMENT.md.
ENCRYPTION_KEY=<store_in_secret_manager>

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Explicit origins only. `*` with credentials enabled lets any site read
# authenticated responses; the process refuses to start on it.
CORS_ORIGINS=https://<your-domain>,https://www.<your-domain>,https://admin.<your-domain>

# Required behind a reverse proxy or load balancer. Without it every request
# looks like it came from the proxy, so rate limits become global and the audit
# log records the wrong client IP.
TRUST_PROXY=true
BODY_LIMIT=2mb

# ---------------------------------------------------------------------------
# Rate limiting — per window, per client
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_PRIVACY_MAX=8
RATE_LIMIT_PASSWORD_MAX=8
RATE_LIMIT_OAUTH_MAX=15

# Application-layer WAF. A CDN/WAF in front is still required for volumetric
# DDoS — this only sees traffic that already reached the process.
WAF_ENABLED=true

# ---------------------------------------------------------------------------
# Backups — targets, not a guarantee. Verify with a real restore.
# ---------------------------------------------------------------------------
RPO_MINUTES=15
RTO_MINUTES=60
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Auth policy
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=8
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGINS=8
ACCOUNT_LOCK_MINUTES=30
SESSION_IDLE_HOURS=336
MFA_CHALLENGE_TTL_SECONDS=300

# Passkeys / WebAuthn. RP_ID is the registrable domain WITHOUT scheme or port,
# and it must cover every origin you serve the app from. A passkey registered
# under one RP_ID cannot be used under another, so changing this later
# invalidates every enrolled passkey.
WEBAUTHN_RP_ID=<your-domain>
WEBAUTHN_RP_NAME=<Your Marketplace Name>
WEBAUTHN_ORIGIN=https://<your-domain>

# ---------------------------------------------------------------------------
# OAuth — client IDs are public, secrets stay server-side.
# Never ship any of these in a Flutter build.
# docs/GOOGLE_OAUTH_PRODUCTION.md, APPLE_LOGIN_PRODUCTION.md, etc.
# ---------------------------------------------------------------------------
# Comma-separated: web, Android, iOS and desktop clients each have their own ID
# and all are accepted as valid audiences.
GOOGLE_CLIENT_IDS=<web_client_id>.apps.googleusercontent.com,<android_client_id>.apps.googleusercontent.com,<ios_client_id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<store_in_secret_manager>

APPLE_CLIENT_IDS=<com.yourcompany.yourapp>,<your.service.id>
FACEBOOK_APP_ID=<facebook_app_id>
FACEBOOK_APP_SECRET=<store_in_secret_manager>
MICROSOFT_CLIENT_ID=<microsoft_application_client_id>
MICROSOFT_CLIENT_SECRET=<store_in_secret_manager>
MICROSOFT_TENANT=common

# Cloudflare Turnstile. Without it the API falls back to a weak internal
# captcha; set it in production. Free at the time of writing.
TURNSTILE_SECRET=<store_in_secret_manager>
CAPTCHA_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Listings
# ---------------------------------------------------------------------------
LISTING_TTL_DAYS=30
LISTING_MAX_MEDIA=20
GUEST_SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Email — REQUIRED. EMAIL_DRIVER=log blocks production boot.
#
# `smtp` is the no-cost path: any mailbox on a domain you control works.
# The sender domain needs SPF, DKIM and DMARC or your mail lands in spam and
# OTP delivery becomes unreliable. See docs/EMAIL_PRODUCTION_SETUP.md.
# ---------------------------------------------------------------------------
EMAIL_DRIVER=smtp
EMAIL_FROM=<Your Marketplace> <no-reply@<your-domain>>
EMAIL_REPLY_TO=support@<your-domain>

SMTP_HOST=<smtp-host>
SMTP_PORT=587
# Leave unset for STARTTLS on 587; set true for implicit TLS on 465.
# SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=<smtp_username>
SMTP_PASSWORD=<store_in_secret_manager>
SMTP_TIMEOUT_MS=15000
SMTP_MAX_CONNECTIONS=5

# ---------------------------------------------------------------------------
# SMS — optional. Costs money per message; there is no free tier.
# Leaving SMS_DRIVER=log means SMS OTP is unavailable (email OTP still works).
# ---------------------------------------------------------------------------
SMS_DRIVER=log
# SMS_DRIVER=http
# SMS_API_URL=<your_sms_relay_endpoint>
# SMS_API_KEY=<store_in_secret_manager>
# SMS_SENDER_ID=<alphanumeric_sender_id>

# ---------------------------------------------------------------------------
# Push — Firebase Cloud Messaging, HTTP v1.
#
# The legacy server-key API is decommissioned, so a bare API key will not work:
# a service account is required. Prefer the whole JSON blob from your secret
# manager. FCM itself is free.
# docs/PUSH_NOTIFICATION_PRODUCTION_SETUP.md
# ---------------------------------------------------------------------------
PUSH_DRIVER=fcm
FCM_SERVICE_ACCOUNT_JSON=<paste_service_account_json_from_secret_manager>
# Or, as discrete values (newlines in the key escaped as \n):
# FCM_PROJECT_ID=<firebase_project_id>
# FCM_CLIENT_EMAIL=<name>@<project>.iam.gserviceaccount.com
# FCM_PRIVATE_KEY=<store_in_secret_manager>
PUSH_TIMEOUT_MS=10000
PUSH_CONCURRENCY=8
# Must match the channel the Android client creates, or notifications are
# silently dropped on Android 8+.
PUSH_ANDROID_CHANNEL_ID=marketplace_default
PUSH_WEB_ICON_URL=https://<your-domain>/icons/notification.png

# ---------------------------------------------------------------------------
# WhatsApp — optional, and NOT free. Conversation-based pricing applies.
# Business-initiated messages (OTP, alerts) require pre-approved templates.
# docs/WHATSAPP_PRODUCTION_SETUP.md
# ---------------------------------------------------------------------------
WHATSAPP_DRIVER=log
# WHATSAPP_DRIVER=cloud
# WHATSAPP_PHONE_NUMBER_ID=<phone_number_id>
# WHATSAPP_ACCESS_TOKEN=<store_in_secret_manager>
# Required when WHATSAPP_DRIVER=cloud: verifies inbound webhook signatures.
# WHATSAPP_APP_SECRET=<store_in_secret_manager>
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=<random_string_you_choose>
# WHATSAPP_OTP_TEMPLATE_NAME=<approved_authentication_template>
# WHATSAPP_ALERT_TEMPLATE_NAME=<approved_utility_template>
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_TEMPLATE_LANGUAGES=en_US,ar,ur
WHATSAPP_TIMEOUT_MS=15000

# Send an SMS when WhatsApp OTP is requested but unavailable. Same phone
# number, so no data crosses identifiers.
OTP_WHATSAPP_FALLBACK_TO_SMS=true

NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_JOB_BATCH=40

# ---------------------------------------------------------------------------
# Storage — object storage strongly recommended.
#
# STORAGE_DRIVER=local writes to the container filesystem: it does not survive
# a redeploy and is not shared between replicas. Use it only for a single-node
# deployment with a mounted volume. gcs and azure have no implemented driver
# and are rejected at boot.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=s3
S3_BUCKET=<bucket_name>
S3_REGION=<region>
S3_ACCESS_KEY_ID=<store_in_secret_manager>
S3_SECRET_ACCESS_KEY=<store_in_secret_manager>
# Set for S3-compatible providers (MinIO, Cloudflare R2, Backblaze B2).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# Public base URL for stored media. Must not be localhost.
STORAGE_PUBLIC_URL=https://cdn.<your-domain>
CDN_PUBLIC_URL=https://cdn.<your-domain>
STORAGE_LOCAL_DIR=storage/uploads

# Absolute path to ffmpeg. Without it, listing videos stay `processing` and
# review videos stay `pending` — they are never falsely marked ready.
FFMPEG_PATH=/usr/bin/ffmpeg

# ---------------------------------------------------------------------------
# Localisation defaults
# ---------------------------------------------------------------------------
BASE_CURRENCY=USD
DEFAULT_COUNTRY=<US>
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Provider drivers
# ---------------------------------------------------------------------------
# `heuristic` is rule-based, not a model. Set AI_API_KEY to enable real
# generation, vision and speech-to-text. docs/AI_PRODUCTION_SETUP.md
AI_PROVIDER=heuristic
# AI_PROVIDER=openai
# AI_API_KEY=<store_in_secret_manager>
# AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# `local` uses the bundled gazetteer — no external calls, no cost, lower
# accuracy for free-text address lookup.
GEO_DRIVER=local
# `ecb` fetches daily reference rates from the European Central Bank (free).
FX_DRIVER=ecb
# `static` derives karat prices from the stored 24K spot rate plus FX. There is
# no live metals feed driver; a live rate needs a provider integration.
GOLD_RATE_DRIVER=static

# The heuristic driver scores every public IP as zero risk, so VPN/proxy/
# reputation signals contribute nothing until a licensed provider is wired.
# Risk scoring still works from the other signals.
IP_REPUTATION_DRIVER=heuristic

MAP_PROVIDER=openstreetmap
# GOOGLE_MAPS_API_KEY=<store_in_secret_manager>
# MAP_TILE_URL=
# MAP_SATELLITE_TILE_URL=

# ---------------------------------------------------------------------------
# Realtime and calling
# ---------------------------------------------------------------------------
ENABLE_JOBS=true
ENABLE_REALTIME=true
# Disable the interactive API browser on a public deployment.
ENABLE_SWAGGER=false

# A STUN server alone fails for roughly 10-20% of peers behind symmetric NAT.
# A TURN relay is required for reliable calling; it consumes bandwidth.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turns:<turn-host>:5349
TURN_USERNAME=<turn_username>
TURN_CREDENTIAL=<store_in_secret_manager>
# TURN_SECRET=<store_in_secret_manager>

# Masked calling. `log` means no real numbers are bridged.
TELECOM_DRIVER=log
CALL_RING_TIMEOUT_SECONDS=45
MESSAGE_EDIT_WINDOW_MINUTES=15
CHAT_MEDIA_URL_TTL_SECONDS=3600
MASKED_CALL_TTL_HOURS=24
MASKED_CALLS_PER_DAY=20

# ---------------------------------------------------------------------------
# Payments — keep TEST keys until staging sign-off is complete.
#
# Switching to live keys is an explicit, separate change. Never enable live
# mode in the same release that first deploys payment code.
# docs/PAYMENT_PRODUCTION_SETUP.md
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=<store_in_secret_manager>
# Publishable key is safe to expose to clients.
STRIPE_PUBLISHABLE_KEY=<stripe_publishable_key>
# Per-endpoint signing secret from the Stripe dashboard. Required: unsigned
# webhooks are rejected in production.
STRIPE_WEBHOOK_SECRET=<store_in_secret_manager>

PAYPAL_CLIENT_ID=<paypal_client_id>
PAYPAL_CLIENT_SECRET=<store_in_secret_manager>
PAYPAL_WEBHOOK_ID=<paypal_webhook_id>
# Flip to `live` only after staging sign-off.
PAYPAL_MODE=sandbox

PAYMENT_WEBHOOK_SECRET=<store_in_secret_manager>
SUPPORT_WEBHOOK_SECRET=<store_in_secret_manager>
